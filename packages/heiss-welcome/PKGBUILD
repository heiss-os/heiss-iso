# Maintainer: Heiss OS <https://github.com/heiss-os>
# Built from the repository HEAD by scripts/heiss-packages-build.sh (it creates heiss-src.tar.gz).
pkgname=heiss-welcome
pkgver=0.1.0
pkgrel=4
pkgdesc='Heiss OS first-run wizard: profile choice, hardware and privacy screens, applying through the helper'
arch=('any')
url='https://github.com/heiss-os/heiss-iso'
license=('GPL-3.0-or-later')
depends=('python' 'pyside6' 'heiss-core')
optdepends=('heiss-helper: apply the chosen profile (needs administrator rights)'
            'inter-font: interface font')
source=('heiss-src.tar.gz')
sha256sums=('SKIP')   # archive made locally from git HEAD; not a downloaded file

package() {
  cd "$srcdir/heiss-src"
  local sp
  sp="$(python -c 'import sysconfig; print(sysconfig.get_path("purelib"))')"
  install -d "$pkgdir$sp"
  cp -r welcome/heiss_welcome "$pkgdir$sp/"
  find "$pkgdir$sp" -name __pycache__ -prune -exec rm -rf {} +
  install -Dm755 welcome/data/heiss-welcome "$pkgdir/usr/bin/heiss-welcome"
  # autostart only: the live session is excluded inside the Exec line (test -e /run/archiso)
  install -Dm644 welcome/data/heiss-welcome.desktop "$pkgdir/etc/xdg/autostart/heiss-welcome.desktop"
}
