# Maintainer: Heiss OS <https://github.com/heiss-os>
# Built from the repository HEAD by scripts/heiss-packages-build.sh (it creates heiss-src.tar.gz).
pkgname=heiss-control
pkgver=0.1.0
pkgrel=8
pkgdesc='Heiss OS Control Center: overview, profiles (with saved actions), appearance, security, network and privacy, advanced and system information'
arch=('any')
url='https://github.com/heiss-os/heiss-iso'
license=('GPL-3.0-or-later')
depends=('python' 'pyside6' 'heiss-core')
optdepends=('inter-font: interface font'
            'kconfig: read the current colour scheme (kreadconfig6)'
            'plasma-workspace: switch the colour scheme (plasma-apply-lookandfeel)'
            'systemsettings: the stock KDE settings opened from the Advanced page')
source=('heiss-src.tar.gz')
sha256sums=('SKIP')   # archive made locally from git HEAD; not a downloaded file

package() {
  cd "$srcdir/heiss-src"
  local sp
  sp="$(python -c 'import sysconfig; print(sysconfig.get_path("purelib"))')"
  install -d "$pkgdir$sp"
  cp -r control/heiss_control "$pkgdir$sp/"
  find "$pkgdir$sp" -name __pycache__ -prune -exec rm -rf {} +
  install -Dm755 control/data/heiss-control "$pkgdir/usr/bin/heiss-control"
  install -Dm644 control/data/heiss-control.desktop "$pkgdir/usr/share/applications/heiss-control.desktop"
}
