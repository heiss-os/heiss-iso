# Maintainer: Heiss OS <https://github.com/heiss-os>
# Built by scripts/heiss-packages-build.sh (the build script copies this directory, so the script is a local source).
pkgname=heiss-safe-graphics
pkgver=0.1.0
pkgrel=2
pkgdesc='Heiss OS: "safe graphics" GRUB menu entry (nomodeset, NVIDIA modules blacklisted) for recovery from a bad GPU driver'
arch=('any')
url='https://github.com/heiss-os/heiss-iso'
license=('GPL-3.0-or-later')
depends=('grub')
source=('41_heiss_safe')
sha256sums=('0ac42f6f719ad2bc722c74263c9cfe6a9b1dac8907a881b83158df9661f8bd5d')

package() {
  # /etc/grub.d is read by grub-mkconfig; the script is not a config file the user edits (no backup=).
  install -Dm755 "$srcdir/41_heiss_safe" "$pkgdir/etc/grub.d/41_heiss_safe"
}
