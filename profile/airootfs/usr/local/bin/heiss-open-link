#!/usr/bin/env python3
"""Heiss OS live helper: opens two whitelisted links for the installer sidebar.

Calamares runs as root and cannot reach the live user's browser. This helper runs
as the live user, listens on 127.0.0.1 only and accepts exactly:
    GET /open?name=telegram  ->  https://t.me/heiss_os
    GET /open?name=x         ->  https://x.com/heiss_OS
Nothing from the request is ever used in a command line or URL.
"""
import subprocess
import time
from http.server import BaseHTTPRequestHandler, HTTPServer
from urllib.parse import urlsplit, parse_qs

HOST, PORT = "127.0.0.1", 48731
LINKS = {
    "telegram": "https://t.me/heiss_os",
    "x": "https://x.com/heiss_OS",
}
MIN_INTERVAL = 1.0  # seconds between two opens
_last = 0.0


class Handler(BaseHTTPRequestHandler):
    server_version = "heiss-open-link"

    def _reply(self, code, body=b""):
        self.send_response(code)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        global _last
        parts = urlsplit(self.path)
        if parts.path != "/open":
            return self._reply(404)
        names = parse_qs(parts.query).get("name", [])
        url = LINKS.get(names[0]) if len(names) == 1 else None
        if url is None:
            return self._reply(400)
        now = time.monotonic()
        if now - _last < MIN_INTERVAL:
            return self._reply(429)
        _last = now
        # fixed URL from the whitelist, argument list, no shell
        subprocess.Popen(["xdg-open", url], stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self._reply(204)

    # every other method is refused
    def _refuse(self):
        self._reply(405)

    do_POST = do_PUT = do_DELETE = do_HEAD = do_PATCH = do_OPTIONS = _refuse

    def log_message(self, *args):
        pass


if __name__ == "__main__":
    HTTPServer((HOST, PORT), Handler).serve_forever()
