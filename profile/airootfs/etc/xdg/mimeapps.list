# Heiss OS: system-wide default applications (XDG mimeapps.list, read by KDE, xdg-open and Dolphin).
# One default per job; only apps that are in the Base profile. Per-user choices (~/.config/mimeapps.list) win.
# Both a type and its alias are listed where tools disagree on which name they look up.
# Checked by scripts/check-mimeapps.py (types exist, every app ships in a Base package).

[Default Applications]

inode/directory=org.kde.dolphin.desktop;

