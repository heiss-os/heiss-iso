[Unit]
Description=Heiss OS privileged helper

[Service]
Type=dbus
BusName=org.heiss.Helper1
ExecStart=/usr/bin/python3 -m heiss_helper
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
RestrictRealtime=yes
LockPersonality=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
