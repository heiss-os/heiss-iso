[Desktop Entry]
Type=Application
Name=Heiss Key Bindings
Name[ru]=Сочетания клавиш Heiss
Comment=The key bindings of your desktop, read from the Hyprland configuration
Comment[ru]=Сочетания клавиш вашего рабочего стола из конфигурации Hyprland
Exec=heiss-welcome --force
Icon=input-keyboard
Categories=System;
Keywords=heiss;welcome;keys;shortcuts;bindings;
StartupWMClass=heiss-welcome
Terminal=false
